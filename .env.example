# Required: the root agent's static fallback model and every agent/subagent
# under agent/subagents/ call Anthropic directly (not through Vercel AI
# Gateway), so this key is needed regardless of per-user provider settings.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for the /settings page: encrypts per-user AI provider API keys at rest.
# Generate with: openssl rand -base64 32
# Rotating this secret invalidates every already-stored provider key.
MODEL_KEY_ENCRYPTION_SECRET=

# Required for web search (agent/tools/web_search.ts, overrides the built-in
# provider-managed tool). Get a key at https://exa.ai
EXA_API_KEY=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=
ATLASSIAN_CONNECTOR=
SHORTCUT_CONNECTOR=

# Required for the sandbox idle-cleanup cron (app/api/cron/sandbox-cleanup):
# authenticates requests to that route. Vercel Hobby plans cap Cron Jobs at
# once/day, so this project schedules the call via an Upstash QStash schedule
# instead — configure its destination request to send this value as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Optional: MXC Hyper-V Isolated Sandbox Integration
# Defaults to C:\Users\MennoDrescher\source\repos\mxc if not provided.
MXC_REPO_ROOT=
MXC_EXEC_PATH=
